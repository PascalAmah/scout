{
  "name": "@scout/extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit"
  },
  "manifest": {
    "permissions": [
      "storage"
    ],
    "host_permissions": [
      "http://localhost:8000/*",
      "https://api.scout.app/*"
    ],
    "action": {
      "default_title": "Save to Scout"
    }
  },
  "dependencies": {
    "plasmo": "^0.90.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2"
  }
}
