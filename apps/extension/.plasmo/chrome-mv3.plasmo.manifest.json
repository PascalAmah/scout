{
  "icons": {
    "16": "./gen-assets/icon16.plasmo.png",
    "32": "./gen-assets/icon32.plasmo.png",
    "48": "./gen-assets/icon48.plasmo.png",
    "64": "./gen-assets/icon64.plasmo.png",
    "128": "./gen-assets/icon128.plasmo.png"
  },
  "manifest_version": 3,
  "action": {
    "default_title": "Save to Scout"
  },
  "version": "0.1.0",
  "name": "DEV | ",
  "background": {
    "service_worker": "./static/background/index.ts"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.ycombinator.com/companies/*"
      ],
      "js": [
        "..\\contents\\detect-yc.ts"
      ]
    },
    {
      "matches": [
        "*://*/*career*",
        "*://*/*jobs/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.ashbyhq.com/*"
      ],
      "js": [
        "..\\contents\\detect-generic-careers.ts"
      ]
    }
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://api.scout.app/*"
  ]
}
