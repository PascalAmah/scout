# Production build config for the Scout extension.
# Applied automatically when running `plasmo build` (NODE_ENV=production).
# `plasmo dev` ignores this file — dev falls back to localhost in code.

# API base URL. Must stay within the host_permissions in apps/extension/package.json.
# PLASMO_PUBLIC_API_BASE=https://api.scout.app/v1
PLASMO_PUBLIC_API_BASE=https://scout-6jlt.onrender.com/v1
# Web app base URL used for the popup's "Create an account" and "Open in Scout →"
# links. TODO: replace with the real domain when the web app is deployed.
# PLASMO_PUBLIC_WEB_BASE=https://scout.app
PLASMO_PUBLIC_WEB_BASE=https://scout-web-bice.vercel.app/
