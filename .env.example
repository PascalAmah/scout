# ---- app ----
ENVIRONMENT=development
APP_NAME=Scout API

# ---- cors ----
# JSON list of browser origins allowed to call the API (web app dev/prod origins).
# The extension is exempt (host_permissions bypass CORS in MV3).
CORS_ORIGINS=["http://localhost:5173","https://scout.app"]

# ---- database ----
DATABASE_URL=postgresql+psycopg://scout:scout@localhost:5432/scout

# ---- redis ----
REDIS_URL=redis://localhost:6379/0

# ---- file storage (local dev; Cloudflare R2 in production) ----
FILE_STORE_DIR=data/files

# ---- auth ----
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-32b
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-please-32b
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- email (Resend) ----
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Scout <hello@yourdomain.com>
WEB_APP_URL=http://localhost:5173

# ---- ai (any OpenAI-compatible provider) ----
# Pick a provider and drop in a key. All chat/structured/embedding calls run
# through this one config via the OpenAI-compatible wire format.
# Providers: openai | gemini | deepseek | groq | openrouter | ollama
AI_PROVIDER=gemini
AI_API_KEY=your-provider-api-key
# AI_MODEL=                      # optional — defaults per provider (e.g. gemini-2.5-flash, deepseek-chat)
# AI_BASE_URL=                   # optional — override provider endpoint

# Embeddings run independently (some providers, e.g. DeepSeek, have none).
# When unset/unavailable, Scout falls back to deterministic pseudo-vectors.
# AI_EMBEDDING_PROVIDER=gemini
# AI_EMBEDDING_API_KEY=your-embedding-key
# EMBEDDING_MODEL=               # optional — defaults per provider
# EMBEDDING_DIM=1536             # must match the pgvector column (gemini-embedding-001 = 3072)

# Legacy aliases (kept for compatibility — AI_API_KEY wins if both are set)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
