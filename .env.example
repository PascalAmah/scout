# ---- app ----
ENVIRONMENT=development
APP_NAME=Scout API

# ---- database ----
DATABASE_URL=postgresql+psycopg://scout:scout@localhost:5432/scout

# ---- redis ----
REDIS_URL=redis://localhost:6379/0

# ---- auth ----
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-32b
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-please-32b
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- email (Resend) ----
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Scout <hello@yourdomain.com>
WEB_APP_URL=http://localhost:5173

# ---- embeddings (Phase 2) ----
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1536
